function doGet(){return out_({success:true,api:'MoneyPulse API',version:MP.VER,status:'available',serverTime:now_()})}function doPost(e){let r={};try{r=parse_(e);check_(r);if(r.action==='HEALTH_CHECK')return doGet();let u=verify_(r.identityToken);if(r.action==='AUTHENTICATE')return ok_(r,{authenticated:true,displayEmail:mask_(u),apiVersion:MP.VER});if(r.action==='GET_APP_STATE')return ok_(r,state_());let d=route_(r.action,r.payload||{});audit_(r,'SUCCESS',u,d.id||'','');return ok_(r,d)}catch(x){return out_({success:false,requestId:r.requestId||'',error:{code:x.code||'ERROR',message:x.publicMessage||'MoneyPulse could not complete the request.'}})}}function route_(a,p){if(a==='CREATE_TRANSACTION')return createTx_(p);if(a==='UPDATE_TRANSACTION')return updateTx_(p);if(a==='DELETE_TRANSACTION')return remove_(MP.S.TX,'id',p.id);if(a==='CREATE_INVESTMENT')return createInv_(p);if(a==='UPDATE_INVESTMENT')return updateInvestment_(p);if(a==='DELETE_INVESTMENT')return remove_(MP.S.INV,'Investment ID',p.id);if(a==='CREATE_DEBT_ASSET')return createDebt_(p);if(a==='UPDATE_DEBT_ASSET')return updateDebt_(p);if(a==='DELETE_DEBT_ASSET')return remove_(MP.S.DEBT,'Asset ID',p.id);if(a==='CREATE_OTHER_ASSET')return createOther_(p);if(a==='UPDATE_OTHER_ASSET')return updateOther_(p);if(a==='DELETE_OTHER_ASSET')return remove_(MP.S.OTHER,'Asset ID',p.id);if(a==='CREATE_LOAN')return createLoan_(p);if(a==='UPDATE_LOAN')return updateLoan_(p);if(a==='DELETE_LOAN')return remove_(MP.S.LOAN,'Loan ID',p.id);if(a==='CREATE_NET_WORTH_SNAPSHOT')return snapshot_(p);if(a==='UPDATE_NET_WORTH_SNAPSHOT')return updateSnapshot_(p);if(a==='DELETE_NET_WORTH_SNAPSHOT')return remove_(MP.S.NW,'Snapshot Month',p.id);if(a==='START_IMPORT')return startImport_(p);if(a==='GET_IMPORT_STATUS')return importStatus_(p);if(a==='CANCEL_IMPORT')return cancelImport_(p);if(a==='CREATE_CATEGORY')return createDef_(MP.S.CAT,p);if(a==='CREATE_ACCOUNT')return createDef_(MP.S.ACC,p);if(a==='CREATE_TAG')return createDef_(MP.S.TAG,p);if(a==='RENAME_CATEGORY')return renameDef_(MP.S.CAT,p,'category');if(a==='RENAME_ACCOUNT')return renameDef_(MP.S.ACC,p,'account');if(a==='REORDER_CATEGORIES')return reorder_(MP.S.CAT,p.names);if(a==='REORDER_ACCOUNTS')return reorder_(MP.S.ACC,p.names);throw err_('UNSUPPORTED','Unsupported action.')}function state_(){ensureSheets_();return{apiVersion:MP.VER,currency:'INR',locale:'en-IN',transactions:rows_(MP.S.TX),categories:active_(MP.S.CAT),accounts:active_(MP.S.ACC),tags:active_(MP.S.TAG),investments:rows_(MP.S.INV),debtAssets:rows_(MP.S.DEBT),loans:rows_(MP.S.LOAN),otherAssets:rows_(MP.S.OTHER),snapshots:rows_(MP.S.NW),serverTime:now_()}}function ensureSheets_(){ensure_(MP.S.OTHER,['Asset ID','Name','Category','Purchase Value','Current Value','Acquisition Date','Last Valuation Date','Notes','Updated At']);ensure_(MP.S.STAGE,['importSessionId','rowNumber','rowJson'],true)}function normalizeTx_(p){let type=text_(p.type).toUpperCase(),amount=Number(p.amount),date=date_(p.date),description=text_(p.description),account=canon_(MP.S.ACC,p.account);if(!['INCOME','EXPENSE','TRANSFER'].includes(type))throw err_('TYPE','Choose Income, Expense, or Transfer.');if(!date||!description||!account||!isFinite(amount)||amount<=0)throw err_('INVALID','Date, description, amount and account are required.');let category=type==='TRANSFER'?'Transfer':canon_(MP.S.CAT,p.category),to=type==='TRANSFER'?canon_(MP.S.ACC,p.transferTo):'';if(!category)throw err_('CATEGORY','Category is required.');if(type==='TRANSFER'&&(!to||key_(to)===key_(account)))throw err_('TRANSFER','Transfer accounts must be different.');return{date,description,category,amount,type,account,transferTo:to,tagsJson:JSON.stringify(tags_(p.tags||p.tagsJson)),notes:text_(p.notes),source:text_(p.source)||'PWA'}}function createTx_(p){let o=normalizeTx_(p);o.id='TXN-'+Utilities.getUuid();o.createdAt=now_();o.updatedAt=o.createdAt;append_(MP.S.TX,o);ensureTags_(o.tagsJson);return{id:o.id,message:'Transaction added.'}}function updateTx_(p){let h=find_(MP.S.TX,'id',p.id);if(!h)throw err_('NOT_FOUND','Transaction not found.');if(text_(p.type)&&text_(p.type).toUpperCase()!==text_(h.record.type).toUpperCase())throw err_('TYPE_LOCKED','Transaction type cannot be changed.');let o=normalizeTx_(Object.assign({},h.record,p));o.id=h.record.id;o.createdAt=h.record.createdAt;o.updatedAt=now_();write_(MP.S.TX,h.row,o);return{id:o.id}}function createInv_(p){let id='INV-'+Utilities.getUuid();append_(MP.S.INV,{'Investment ID':id,'Ticker':text_(p.ticker),'Asset Class':text_(p.assetClass),'Investment Name':'','Units':Number(p.units||0),'Manual Price / NAV':Number(p.manualPrice||0),'Invested Amount':Number(p.investedAmount||0),'Live Price / NAV':'','Current Value':'','Gain / Loss':'','Gain %':'','Last Price Time':'','Notes':text_(p.notes)});let s=sheet_(MP.S.INV),r=s.getLastRow();s.getRange(r,4).setFormula('=IF(B'+r+'="","",IFERROR(GOOGLEFINANCE(B'+r+',"name"),B'+r+'))');s.getRange(r,8).setFormula('=IF(B'+r+'="","",IFERROR(IF(C'+r+'="Mutual Fund",GOOGLEFINANCE(B'+r+',"closeyest"),GOOGLEFINANCE(B'+r+',"price")),F'+r+'))');s.getRange(r,9).setFormula('=IF(OR(E'+r+'="",H'+r+'=""),"",E'+r+'*H'+r+')');s.getRange(r,10).setFormula('=IF(OR(I'+r+'="",G'+r+'=""),"",I'+r+'-G'+r+')');s.getRange(r,11).setFormula('=IF(OR(G'+r+'="",J'+r+'=""),"",IFERROR(J'+r+'/G'+r+',""))');s.getRange(r,12).setFormula('=IF(B'+r+'="","",IFERROR(IF(C'+r+'="Mutual Fund",GOOGLEFINANCE(B'+r+',"date"),GOOGLEFINANCE(B'+r+',"tradetime")),""))');return{id}}function createDebt_(p){let id='DEBT-'+Utilities.getUuid();append_(MP.S.DEBT,{'Asset ID':id,'Asset Type':text_(p.assetType),'Provider / Scheme':text_(p.provider),'Account / Reference':text_(p.reference),'Principal / Balance':Number(p.principal||0),'Interest Rate':Number(p.interestRate||0)/100,'Start Date':date_(p.startDate),'Maturity Date':date_(p.maturityDate),'Current Value':Number(p.currentValue||p.principal||0),'Last Updated':date_(new Date()),'Notes':text_(p.notes)});return{id}}function createOther_(p){ensureSheets_();let id='OTHER-'+Utilities.getUuid();append_(MP.S.OTHER,{'Asset ID':id,'Name':text_(p.name),'Category':text_(p.category),'Purchase Value':Number(p.purchaseValue||0),'Current Value':Number(p.currentValue||0),'Acquisition Date':date_(p.acquisitionDate),'Last Valuation Date':date_(new Date()),'Notes':text_(p.notes),'Updated At':now_()});return{id}}function createLoan_(p){let id='LOAN-'+Utilities.getUuid();append_(MP.S.LOAN,{'Loan ID':id,'Loan Type':text_(p.loanType),'Lender':text_(p.lender),'Original Principal':Number(p.originalPrincipal||0),'Outstanding Balance':Number(p.outstandingBalance||0),'Interest Rate':Number(p.interestRate||0)/100,'EMI':Number(p.emi||0),'Start Date':date_(p.startDate),'End Date':date_(p.endDate),'Next Due Date':date_(p.nextDueDate),'Status':text_(p.status)||'Active','Notes':text_(p.notes)});return{id}}function totals_(){let a=rows_(MP.S.ACC),cash=a.filter(x=>!/credit|loan|borrow/i.test((x.name||'')+' '+(x.accountType||''))).reduce((n,x)=>n+Number(x.currentBalance||0),0),equity=rows_(MP.S.INV).reduce((n,x)=>n+Number(x['Current Value']||0),0),debt=rows_(MP.S.DEBT).reduce((n,x)=>n+Number(x['Current Value']||0),0),other=rows_(MP.S.OTHER).reduce((n,x)=>n+Number(x['Current Value']||0),0),liab=rows_(MP.S.LOAN).reduce((n,x)=>n+Number(x['Outstanding Balance']||0),0);return{cash,equity,debt,other,assets:cash+equity+debt+other,liabilities:liab}}function snapshot_(p){let t=totals_(),month=text_(p.snapshotMonth)||Utilities.formatDate(new Date(),MP.TZ,'yyyy-MM-01'),nw=t.assets-t.liabilities,old=rows_(MP.S.NW).slice(-1)[0],prev=Number(old&&old['Net Worth']||0),growth=nw-prev;append_(MP.S.NW,{'Snapshot Month':month,'Cash / Accounts':t.cash,'Equity & Mutual Funds':t.equity,'Debt Assets':t.debt,'Other Assets':t.other,'Total Assets':t.assets,'Loans / Liabilities':t.liabilities,'Net Worth':nw,'Monthly Growth':growth,'Growth %':prev?growth/prev:0,'Notes':text_(p.notes)});return{id:month,netWorth:nw}}function startImport_(p){ensureSheets_();if(!Array.isArray(p.rows)||!p.rows.length)throw err_('NO_ROWS','No CSV rows supplied.');let id='IMP-'+Utilities.getUuid();append_(MP.S.IMP,{importSessionId:id,fileName:text_(p.fileName),fileSize:Number(p.fileSize||0),totalRows:p.rows.length,completedBatchesJson:'[]',status:'IMPORTING',createdAt:now_(),updatedAt:now_(),errorSummary:JSON.stringify({processedRows:0,insertedCount:0,skippedCount:0})});let st=sheet_(MP.S.STAGE),v=p.rows.map((x,i)=>[id,i+1,JSON.stringify(x)]);st.getRange(st.getLastRow()+1,1,v.length,3).setValues(v);ScriptApp.newTrigger('continueMoneyPulseImports').timeBased().after(1000).create();return{importSessionId:id,totalRows:p.rows.length}}function continueMoneyPulseImports(){let sessions=rows_(MP.S.IMP).filter(x=>x.status==='IMPORTING');sessions.forEach(x=>processImport_(x.importSessionId))}function processImport_(id){let h=find_(MP.S.IMP,'importSessionId',id),st=sheet_(MP.S.STAGE),v=st.getLastRow()>1?st.getRange(2,1,st.getLastRow()-1,3).getValues():[],batch=[];for(let i=0;i<v.length&&batch.length<100;i++)if(v[i][0]===id)batch.push({row:i+2,data:JSON.parse(v[i][2])});let z=JSON.parse(h.record.errorSummary||'{}');batch.forEach(x=>{try{ensureCsvDefs_(x.data);createTx_(x.data);z.insertedCount++}catch(e){z.skippedCount++}});batch.map(x=>x.row).sort((a,b)=>b-a).forEach(r=>st.deleteRow(r));z.processedRows+=batch.length;h.record.errorSummary=JSON.stringify(z);h.record.updatedAt=now_();if(z.processedRows>=Number(h.record.totalRows)||!batch.length)h.record.status='COMPLETED';write_(MP.S.IMP,h.row,h.record);if(h.record.status==='IMPORTING')ScriptApp.newTrigger('continueMoneyPulseImports').timeBased().after(1000).create()}function ensureCsvDefs_(p){let type=text_(p.type).toUpperCase();if(!canon_(MP.S.ACC,p.account))append_(MP.S.ACC,{name:clean_(p.account),accountType:'Other',openingBalance:0,currentBalance:0,active:true,sortOrder:9990,createdAt:now_(),updatedAt:now_(),notes:'CSV import'});if(type==='TRANSFER'&&p.transferTo&&!canon_(MP.S.ACC,p.transferTo))append_(MP