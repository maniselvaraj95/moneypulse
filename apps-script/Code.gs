on append_(n,o){let s=sheet_(n),h=headers_(s),r=h.map(k=>o[k]===undefined?'':o[k]);s.getRange(s.getLastRow()+1,1,1,r.length).setValues([r])}function write_(n,row,o){let s=sheet_(n),h=headers_(s),r=h.map(k=>o[k]===undefined?'':o[k]);s.getRange(row,1,1,r.length).setValues([r])}function find_(n,c,v){let a=rows_(n);for(let i=0;i<a.length;i++)if(key_(a[i][c])===key_(v))return{row:i+2,record:a[i]};return null}function canon_(n,v){let k=key_(v);for(let x of rows_(n))if(key_(x.name)===k)return text_(x.name);return''}function remove_(n,c,v){let h=find_(n,c,v);if(!h)throw err_('NOT_FOUND','Record not found.');sheet_(n).deleteRow(h.row);return{id:v}}function tags_(v){let a=Array.isArray(v)?v:String(v||'').split(','),seen={};return a.map(clean_).filter(x=>x&&!seen[key_(x)]&&(seen[key_(x)]=1))}function ensureTags_(j){tags_(JSON.parse(j||'[]')).forEach(x=>{if(!canon_(MP.S.TAG,x))append_(MP.S.TAG,{name:x,active:true,createdAt:now_(),updatedAt:now_()})})}function text_(v){return String(v===undefined||v===null?'':v).trim().replace(/\s+/g,' ')}function key_(v){return text_(v).toLowerCase()}function clean_(v){return text_(v).split(' ').map(w=>w.charAt(0).toUpperCase()+w.slice(1).toLowerCase()).join(' ')}function id_(v){return text_(v).replace(/[^A-Za-z0-9._:-]/g,'').slice(0,160)}function date_(v){let s=text_(v);if(/^\d{4}-\d{2}-\d{2}$/.test(s))return s;let d=new Date(s);return isNaN(d)?'':Utilities.formatDate(d,MP.TZ,'yyyy-MM-dd')}function now_(){return Utilities.formatDate(new Date(),MP.TZ,"yyyy-MM-dd'T'HH:mm:ssXXX")}function mask_(e){let p=text_(e).split('@');return p[0].slice(0,2)+'***@'+p[1]}function out_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}function err_(c,m){let e=new Error(m);e.code=c;e.publicMessage=m;return e}function testMoneyPulseFinal(){ensureSheets_();let s=state_();console.log(JSON.stringify({success:true,version:MP.VER,transactions:s.transactions.length,categories:s.categories.length,accounts:s.accounts.length},null,2));return s}


function updateInvestment_(p){let h=find_(MP.S.INV,'Investment ID',p.id);if(!h)throw err_('NOT_FOUND','Investment not found.');Object.assign(h.record,{'Ticker':text_(p.ticker),'Asset Class':text_(p.assetClass),'Units':Number(p.units||0),'Manual Price / NAV':Number(p.manualPrice||0),'Invested Amount':Number(p.investedAmount||0),'Notes':text_(p.notes)});write_(MP.S.INV,h.row,h.record);return{id:p.id}}
function updateDebt_(p){let h=find_(MP.S.DEBT,'Asset ID',p.id);if(!h)throw err_('NOT_FOUND','Debt asset not found.');Object.assign(h.record,{'Asset Type':text_(p.assetType),'Provider / Scheme':text_(p.provider),'Principal / Balance':Number(p.principal||0),'Interest Rate':Number(p.interestRate||0)/100,'Current Value':Number(p.currentValue||0),'Notes':text_(p.notes),'Last Updated':date_(new Date())});write_(MP.S.DEBT,h.row,h.record);return{id:p.id}}
function updateOther_(p){let h=find_(MP.S.OTHER,'Asset ID',p.id);if(!h)throw err_('NOT_FOUND','Asset not found.');Object.assign(h.record,{'Name':text_(p.name),'Category':text_(p.category),'Purchase Value':Number(p.purchaseValue||0),'Current Value':Number(p.currentValue||0),'Notes':text_(p.notes),'Updated At':now_()});write_(MP.S.OTHER,h.row,h.record);return{id:p.id}}
function updateLoan_(p){let h=find_(MP.S.LOAN,'Loan ID',p.id);if(!h)throw err_('NOT_FOUND','Liability not found.');Object.assign(h.record,{'Loan Type':text_(p.loanType),'Lender':text_(p.lender),'Original Principal':Number(p.originalPrincipal||0),'Outstanding Balance':Number(p.outstandingBalance||0),'Interest Rate':Number(p.interestRate||0)/100,'EMI':Number(p.emi||0),'Notes':text_(p.notes)});write_(MP.S.LOAN,h.row,h.record);return{id:p.id}}
function updateSnapshot_(p){let h=find_(MP.S.NW,'Snapshot Month',p.id);if(!h)throw err_('NOT_FOUND','Snapshot not found.');h.record['Snapshot Month']=text_(p.snapshotMonth)||h.record['Snapshot Month'];h.record['Notes']=text_(p.notes);write_(MP.S.NW,h.row,h.record);return{id:h.record['Snapshot Month']}}
function cancelImport_(p){let h=find_(MP.S.IMP,'importSessionId',p.importSessionId);if(!h)throw err_('NOT_FOUND','Import session not found.');if(h.record.status==='COMPLETED')return{importSessionId:p.importSessionId,status:'COMPLETED'};h.record.status='CANCELLED';h.record.updatedAt=now_();write_(MP.S.IMP,h.row,h.record);return{importSessionId:p.importSessionId,status:'CANCELLED'}}
